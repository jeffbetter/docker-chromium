# Copy to identity-a.env and fill in YOUR values. Never commit the copy.
# Distinct public IPs require a distinct real Trojan exit. This file is not one.

ISO_IDENTITY=identity-a
HOST_VNC_PORT=5901
ISO_DATA_DIR=./data/identity-a
TZ=America/New_York
USER_ID=1000
GROUP_ID=1000
ENABLE_CJK_FONT=1
CHROMIUM_IMAGE=jlesage/chromium:v26.10.1

# Official Trojan client fields (trojan-gfw examples/client.json-example):
#   remote_addr, remote_port, password, ssl.sni, ssl.alpn, ssl.verify=true
TROJAN_SERVER=exit-a.example.invalid
TROJAN_PORT=443
TROJAN_PASSWORD=change-me
TROJAN_SNI=exit-a.example.invalid
TROJAN_ALPN=h2,http/1.1
# Optional PEM CA if the official "ssl.cert" field would be used:
# TROJAN_CERTIFICATE_PATH=/certs/ca.pem

# VNC password is at most 8 characters (RFB). Leave empty only on a locked-down host.
VNC_PASSWORD=change-me
