# Copy to identity-b.env and fill in YOUR values. Never commit the copy.
# identity-b MUST use a different TROJAN_SERVER:TROJAN_PORT than identity-a
# if you need a different public IP. Same exit => same IP. That is not unlinkable.

ISO_IDENTITY=identity-b
HOST_VNC_PORT=5902
ISO_DATA_DIR=./data/identity-b
TZ=America/New_York
USER_ID=1000
GROUP_ID=1000
ENABLE_CJK_FONT=1
CHROMIUM_IMAGE=jlesage/chromium:v26.10.1

TROJAN_SERVER=exit-b.example.invalid
TROJAN_PORT=443
TROJAN_PASSWORD=change-me
TROJAN_SNI=exit-b.example.invalid
TROJAN_ALPN=h2,http/1.1

TROJAN_PUBLIC_EXIT_CLAIM=replace-with-known-exit-b

VNC_PASSWORD=change-me
